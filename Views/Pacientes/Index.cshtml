@model List<ProjetoAgendamento.Models.Paciente>

@{
    ViewData["Title"] = "Pacientes";
}

<div class="actions" style="justify-content: space-between; align-items: center; margin-bottom: 18px;">
    <h1>Pacientes</h1>
    <a class="btn btn-primary" asp-controller="Pacientes" asp-action="Create">Inserir paciente</a>
</div>

@if (Model.Count == 0)
{
    <div class="card">
        <p>Nenhum paciente cadastrado.</p>
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>CPF</th>
                <th>Telefone</th>
                <th>Endereço</th>
                <th>Data de Nascimento</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var paciente in Model)
            {
                <tr>
                    <td>@paciente.Nome</td>
                    <td>@paciente.Cpf</td>
                    <td>@paciente.Telefone</td>
                    <td>@paciente.Endereco</td>
                    <td>@paciente.DataNascimento.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="actions">
                            <a class="btn btn-secondary"
                               asp-controller="Pacientes"
                               asp-action="Edit"
                               asp-route-id="@paciente.Id">Editar</a>

                            <a class="btn btn-danger"
                               asp-controller="Pacientes"
                               asp-action="Delete"
                               asp-route-id="@paciente.Id">Remover</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
