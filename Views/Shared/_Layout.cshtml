<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Projeto Agendamento</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container nav-container">
            <a class="brand" asp-controller="Home" asp-action="Index">Projeto Agendamento</a>
            <nav>
                <a asp-controller="Home" asp-action="Index">Início</a>
                <a asp-controller="Pacientes" asp-action="Index">Pacientes</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">Desenvolvimento Web com .NET</div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
